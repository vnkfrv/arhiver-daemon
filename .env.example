# ===== Флаги поведения (вместо прежнего MODE) =====
# REAL_DELETE=1 — реально удаляем видео из Talk; 0 — удаление ИМИТИРУЕМ (только лог).
# «Сухой прогон» = REAL_DELETE=0 + SEND_TO_TAG=0 + SEND_TO_MAIL=0 (см. ниже).
REAL_DELETE=0

# ===== Контур.Толк API (записи конференций) =====
# Базовый URL пространства Толка, напр. https://talk.<company>.ru
TALK_BASE_URL=https://talk.magnit.ru
# API-ключ пространства (панель админа -> API-ключи). Заголовок X-Auth-Token.
TALK_API_TOKEN=your_api_token
# Проверять TLS-сертификат: 1 — да, 0 — нет (корп-хост с самоподписанным серт.)
TALK_VERIFY_SSL=0
# Качество видео, в котором его скачивать, когда у записи нет аудиоархива и звук берётся из
# видео (GET /api/Recordings/{key}/file/{качество}). Пусто -> без качества (исходное видео),
# запасной вариант — 900p из документации Толка.
# TALK_VIDEO_QUALITY=

# ===== Рабочие окна (ОБЯЗАТЕЛЬНЫ) =====
# Демон работает ТОЛЬКО по временным окнам. Если ни раздельные, ни общие окна не заданы —
# демон НЕ стартует (пишет ошибку и выходит). Формат ЧЧ:ММ, можно через полночь; 24:00 — то же,
# что 00:00. Некорректное время — понятная ошибка на старте.
# РАЗДЕЛЬНО для транскрибации (ASR) и LLM-обработки: ASR обычно шире (готовит расшифровки),
# LLM уже (обрабатывает готовое). Стадии гейтятся: транскрибация — в ASR-окне;
# improve/summarize и пост-стадии — в LLM-окне. Пример: ASR 14:00–05:00, LLM 23:00–05:00.
TIME_START_ASR=14:00
TIME_END_ASR=05:00
TIME_START_LLM=00:01
TIME_END_LLM=05:00
# Общее окно (фоллбэк, если раздельные не заданы).
TIME_START=
TIME_END=
# ГЛАВНАЯ ручка скорости: сколько записей обрабатывать ПАРАЛЛЕЛЬНО (независимые воркеры,
# у каждого своя запись). = число одновременных запросов к шлюзу. Больше -> быстрее разбор
# (в пределах того, что тянет шлюз и лимита ASR_LLM_RPM). Разумно 5–20.
RECORD_WORKERS=10
# Видео старше N дней -> уведомляем участников и планируем удаление (по ТЗ — год)
DELETE_VIDEO_AGE_DAYS=90
# Сколько хранить тексты после удаления видео (по ТЗ — 5 лет = 1825).
# ПУСТО/не задано -> тексты НЕ удаляются никогда (хранятся бессрочно). Только целое число
# дней: «5 лет» или отрицательное значение — ошибка на старте.
TEXT_RETENTION_DAYS=1825
# Минимальная длина записи (сек): короче — НЕ транскрибируем, удаляем при подхвате
# (prod — реально из Толка; test — заглушка в лог). Не удалось удалить — повторы по той же
# лестнице, что и у стадий (RETRY_DELAYS_MIN).
MIN_DURATION=0
# Лестница повторов упавшей стадии (любой: транскрибация, LLM, сохранение, рассылка,
# удаление) — в МИНУТАХ ОТ ПЕРВОЙ ОШИБКИ, через запятую: повторы через 5 мин, 30 мин,
# 180 мин и 23 ч после неё (второй — через 30 минут после ошибки, а не через 5+30).
# Если и последний не помог — запись получает статус FAILED_<стадия> (FAILED_ASR, FAILED_LLM…)
# и стоит, пока админ не даст команду restart_passed; админы узнают об этом из суточной сводки.
# Повтор, выпавший на закрытое рабочее окно, выполняется при его открытии; пропущенные
# отметки не «догоняются». Пусто -> значения по умолчанию. Для теста можно короче: 1,2,3,5.
RETRY_DELAYS_MIN=5,30,180,1380
# Суточная сводка админам в Tag (ЧЧ:ММ по часам демона — тем же, что и рабочие окна): одно
# сообщение о записях, которые за сутки встали в ожидание админа, с разбивкой по статусам
# (FAILED_ASR, FAILED_LLM, FAILED_SHORT, FAILED_SAVE, FAILED_NOTIFY, FAILED_DELETE,
# FAILED_CLEANUP). Никто не встал — сообщения нет.
ADMIN_REPORT_TIME=09:00
# Часовой пояс контейнеров: по нему считаются рабочие окна и время сводки. У ВМ контейнер его
# НЕ берёт — без этой строки всё идёт по UTC. Окна задуманы по Москве — раскомментируй.
# TZ=Europe/Moscow
# Через сколько СЕКУНД после уведомления удалять видео. По умолчанию test=180, prod=604800 (неделя).
# Только целое число секунд (не «7d»): кривое значение — ошибка на старте.
# DELETE_AFTER_NOTIFICATION=
# Язык распознавания
ASR_LANGUAGE=ru
# Что делать с видео, которые Толк запрещает удалять (canBeRemoved=false):
# 0 — не трогать: запись получает статус DELETE_PROTECTION, участников не уведомляем;
# 1 — удалять принудительно (осторожно!).
FORCE_DELETE=0
# Путь к SQLite-витрине записей
DB_PATH=data/recordings.db

# ===== MagnitGPT_ASR (корп. OpenAI-совместимый ASR) =====
MAGNITGPT_API_KEY=your_api_token
MAGNITGPT_BASE_URL=base_url_for_api
MAGNITGPT_MODEL=gpt_model_name
# Проверять TLS сертификат шлюза: 1 — да, 0 — нет
MAGNITGPT_VERIFY_SSL=0
# Резать дорожки длиннее N секунд на части
ASR_CHUNK_SEC=600
# Лимит ЧАСТОТЫ запросов к шлюзу (ASR+LLM вместе, скользящее окно 60с). Число
# ОДНОВРЕМЕННЫХ запросов = RECORD_WORKERS (воркеры обрабатывают разные записи параллельно).
ASR_LLM_RPM=30

# ===== MagnitGPT чат-LLM (полная расшифровка + короткая выжимка) =====
# Пусто -> шаги improve/summarize пропускаются (демон вернётся, когда LLM появится).
MAGNITGPT_LLM_API_KEY=your_api_token
MAGNITGPT_LLM_MODEL=gpt_model_name
# По умолчанию тот же шлюз, что и ASR (MAGNITGPT_BASE_URL). Переопредели при необходимости:
MAGNITGPT_LLM_BASE_URL=base_url_for_api
# Порог разбивки длинного текста на части (символы). Меньше -> части короче, реже
# упираемся в лимит вывода модели, но больше запросов. 8000–12000 — безопасно.
LLM_MAX_CHARS=12000
# Лимит длины ОТВЕТА модели (токены). Если ответ упрётся в него и оборвётся на полуслове,
# enrich это ловит (finish_reason=length) и делит кусок пополам — текст не теряется.
# Ставь ближе к максимуму, который держит модель (частая величина 8192).
LLM_MAX_TOKENS=8192
# Температура LLM. Для дословной правки и выжимки нужна предсказуемость, а не «креатив»:
# 0 — детерминированно, минимум додумывания/выкидывания текста. Поднимать не рекомендуется.
LLM_TEMPERATURE=0
# Порог «усушки»: если улучшенная (_LLM) расшифровка короче дословной (_ASR) более чем
# на N% (сравнение БЕЗ таблицы замен) — сверху в _LLM.md пишется баннер о возможной потере.
LLM_SHRINK_WARN_PCT=5
# Ризонинг («мышление») модели: 0 — выкл (быстрее, для чистки/выжимки не нужен), 1 — вкл.
LLM_THINKING=0

# ===== Tag / Mattermost (бот) =====
# Хост Tag (без схемы), напр. tag.magnit.ru
URL=feature-sandbox.tag-test.corp.tander.ru
SCHEME=https
PORT=443
# Проверять TLS-сертификат Tag: 1 — да, 0 — нет
MM_VERIFY_SSL=0
# Ботов в Tag ДВА (две учётки-бота, у каждой свой токен):
# BOT_TOKEN — основной бот: пишет участникам записей (уведомления, меню, расшифровки).
BOT_TOKEN=your_bot_token
# ADMIN_BOT_TOKEN — админ-бот: админ-панель, админ-команды, суточная сводка, решения о
# составе админов. У админа тоже бывают свои записи — так админская работа не смешивается в
# его личке с уведомлениями о них. Пусто (или тот же токен, что BOT_TOKEN) -> админские функции
# остаются в основном боте.
ADMIN_BOT_TOKEN=your_admin_bot_token
# Адрес, куда Tag шлёт нажатия кнопок и отправку окон. Их принимает nginx (talk-nginx) по HTTPS на
# 443 и передаёт боту. Имя (или IP) — то, на которое выдан сертификат в nginx/certs/; порт не пишем.
BOT_PUBLIC_URL=https://{имя ВМ}
# Порт, который бот слушает ВНУТРИ контейнера. Оставь 8081: на него смотрит nginx (nginx/talk-bot.conf).
BUTTON_PORT=8081
# Порт на самой ВМ для проверки бота в обход nginx: curl http://127.0.0.1:8081/health (снаружи не виден).
BOT_HOST_PORT=8081
# Порт HTTPS на ВМ для nginx; по умолчанию 443.
# NGINX_HTTPS_PORT=443
# Общий секрет: подмешивается в URL кнопок/модалки, бот проверяет его на /action и
# /dialog. Задай непустым в проде, иначе эти эндпоинты открыты без проверки.
BUTTON_SECRET=generate_your_button_secret

# РЕАЛЬНАЯ рассылка ЛС участникам демоном (main.py). 0 — только лог (безопасно,
# «имитация в логах»). 1 — участники ДЕЙСТВИТЕЛЬНО получат сообщения (bot.py должен
# быть поднят). Работает в обоих режимах (в test при 1 — тоже реально шлёт).
SEND_TO_TAG=0

# Дублировать уведомление участнику на КОРПОРАТИВНУЮ ПОЧТУ по SMTP. 0 — выкл, 1 — вкл.
# Работает независимо от SEND_TO_TAG (можно только почту, только Tag, оба или ничего).
# Почта участника берётся из таблицы participant (email из Talk API).
SEND_TO_MAIL=0
# Настройки SMTP-отправителя (нужны при SEND_TO_MAIL=1):
SMTP_SERVER=smtp.corp.tander.ru
SMTP_PORT=587
# starttls (обычно 587) | ssl (обычно 465) | none (25, без шифрования)
SMTP_SECURITY=starttls
# Адрес отправителя (поле From)
SMTP_SENDER=
# Логин для авторизации (если отличается от SMTP_SENDER; иначе можно не задавать)
SMTP_LOGIN=
# Пароль SMTP (если пусто — подключение без авторизации)
SMTP_PASSWORD=

# Логи: ошибка пишется ОДНОЙ строкой — тип, сообщение и место в коде
# («… — HTTPError: 503 … [bot.py:210 _deliver > mm_client.py:103 _request]»).
# 1 — полные трейсбеки (только для отладки).
LOG_TRACEBACKS=0

# Через сколько ЧАСОВ вступает в силу решение ОБЫЧНОГО админа добавить или убрать админа
# (период охлаждения): все админы получают уведомление, суперадмин может решение
# заблокировать. Суперадмин меняет состав админов сразу. Для теста можно дробное: 0.05.
ADMIN_CHANGE_DELAY_HOURS=24

# СУПЕРАДМИН: его username в Tag (можно с «@» и в любом регистре — приведём к виду Tag).
# Назначается при первом запуске бота; дальше он хранится
# в базе и может передать права другому админу через бота. Если ПОМЕНЯТЬ значение здесь и
# перезапустить бота — суперадмином станет указанный (так возвращают управление, когда
# суперадмин недоступен). Команды админа (в ЛС АДМИН-БОТУ):
#   archiever_admin          — админ-панель (поиск и карточка записи, скачивание любой
#                              расшифровки, запрет/удаление видео, остановленные, админы)
#   restart_passed           — вернуть в работу записи «до решения админа»
#   newadmin_{nickname}      — назначить админа (обычный админ — через период охлаждения)
#   remember_{ID}            — пометить видео «хранить в Толке навсегда»
#   delete_{ID}              — удалить видео вручную (любое, даже защищённое remember)
ADMIN_USERNAME=first_admin_username








